# Supabase API URL and public publishable key. Never put an admin/service key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key
# Enable after SMTP and verification/recovery redirect URLs have been configured and tested.
VITE_AUTH_EMAIL_ENABLED=false
